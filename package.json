{
  "name": "submitly",
  "version": "1.0.0",
  "description": "Submitly API for assignment submissions, sequential student progress, and mentor reviews.",
  "main": "dist/src/server.js",
  "scripts": {
    "start": "node --import tsx dist/src/server.js",
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint src prisma",
    "typecheck": "tsc --noEmit",
    "seed": "prisma db seed",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "submitly",
    "assignment-management",
    "student-submissions",
    "mentor-reviews",
    "express",
    "typescript",
    "prisma",
    "better-auth"
  ],
  "type": "module",
  "postinstall": "prisma generate",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.12",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "http-status": "^2.1.0",
    "jsonwebtoken": "^9.0.3",
    "ms": "^2.1.3",
    "pg": "^8.23.1"
  }
}
