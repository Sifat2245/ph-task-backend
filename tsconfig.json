{
  "compilerOptions": {
    "rootDir": "./",
    "allowJs": true,
    "outDir": "./dist",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2023",
    "types": ["node"],
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "ignoreDeprecations": "6.0",
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "exclude": [
    "node_modules", "dist"
  ],
  "include": [
    "src",
    "prisma.config.ts",
    "prisma/**/*.ts"
  ]
}
