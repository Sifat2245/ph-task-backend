NODE_ENV=development
PORT=3000
FRONTEND_URL="http://localhost:3000"
# Optional shared parent domain when the frontend and API use subdomains.
# COOKIE_DOMAIN=".submitly.example"

# Pooled PostgreSQL connection used by the application.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR_POOLED_HOST:5432/DATABASE?sslmode=require"

# Direct PostgreSQL connection used by Prisma CLI commands.
DIRECT_URL="postgresql://USER:PASSWORD@YOUR_DIRECT_HOST:5432/DATABASE?sslmode=require&connect_timeout=15"

# Use a random secret with at least 32 characters.
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SESSION_TOKEN_EXPIRES_IN="1d"
BETTER_AUTH_UPDATE_TOKEN_EXPIRES_IN="1d"

# Use different random secrets for access and refresh JWTs.
JWT_ACCESS_SECRET="replace-with-a-random-access-token-secret-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-a-different-random-refresh-token-secret-at-least-32-characters"
JWT_ACCESS_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Optional passwords for new development seed accounts.
SEED_ADMIN_PASSWORD="Admin123!"
SEED_MENTOR_PASSWORD="Mentor123!"
SEED_STUDENT_PASSWORD="Student123!"

